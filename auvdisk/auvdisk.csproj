<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NETCoreSdkVersion)' >= '9.0.0'">$(TargetFrameworks);net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>Latest</LangVersion>
    <AssemblyName>auvdisk</AssemblyName>
    <Version>1.9.20</Version>
    <Authors>Alexander Automatl</Authors>
    <Company>Tomatl Inc</Company>
    <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
    <NoWarn>NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Common.Logging" Version="3.4.1" />
    <PackageReference Include="DiskAccessLibrary" Version="1.6.4.3" />
    <PackageReference Include="DotNext" Version="5.25.1" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" />
    <PackageReference Include="LTRData.DiscUtils" Version="1.0.69" />
    <PackageReference Include="SimpleExec" Version="12.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.52.0" />
    <PackageReference Include="Terminal.Gui" Version="1.19.0" />
  </ItemGroup>
  <Target Name="PackChoco" DependsOnTargets="Publish">
     <Message Importance="High" Text="Packing $(PublishDir), generating nuspec:" />
     <Exec Command="python3 generate-choco-spec.py $(PublishDir)" />
     <Exec Command="choco pack auvdisk.choco.nuspec" />
  </Target>
  <PropertyGroup Condition="'$(IsWindows)'=='true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="auvdisk.test" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <PackageReference Include="PrettyPrompt" Version="4.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsWindows)'=='true'">
    <PackageReference Include="AlphaVSS" Version="2.0.3" />
    <PackageReference Include="System.Management.Automation" Version="7.4.13" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.13" />
    <PackageReference Include="Win32.TokenPrivileges" Version="1.0.19073.2">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.242">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ausharp\ausharp\ausharp.csproj" />
  </ItemGroup>
</Project>
